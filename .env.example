# ParkVision Frontend — environment variables
# Copy this file to `.env` and fill in the values. Never commit `.env`.
# Vite only exposes variables prefixed with VITE_ to the app (see src/environments/env.ts).

# Base URL of the backend REST API (spoticar-service).
VITE_API_BASE_URL=http://localhost:8080/api/v1

# Google Maps JavaScript API key (Maps, Marker and Places libraries).
VITE_GOOGLE_MAPS_KEY=your-google-maps-api-key

# Optional: support email shown in the Help section. Defaults to soporte@parkvision.pe.
VITE_SUPPORT_EMAIL=
